# Copy to .env; never commit real secrets or private data.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-before-sharing
MODEL_PATH=models/best.pt
YOLOV5_DIR=yolov5
DEVICE=cpu
MAX_UPLOAD_MB=50
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# Opt-in only: creates the publicly documented demo accounts and camera labels.
DEMO_MODE=false
CORS_ORIGINS=[]
ENVIRONMENT=local
REGISTRATION_ENABLED=false
MEDIA_TOKEN_MINUTES=10
MAX_IMAGE_PIXELS=12000000
MAX_VIDEO_SECONDS=120
LOGIN_REQUESTS_PER_MINUTE=10
DETECTION_REQUESTS_PER_MINUTE=60
# For Docker Compose/Caddy: set a real DNS name before publishing.
SITE_ADDRESS=http://localhost

# Optional managed-host provisioning of YOUR trusted custom artifact. No default/fallback URL.
# MODEL_URL=https://your-private-artifact-host/best.pt
# MODEL_SHA256=the-64-character-sha256-of-your-trusted-file
